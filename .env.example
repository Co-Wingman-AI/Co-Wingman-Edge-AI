# Reference only. Co-Wingman reads the shell environment, not .env files.
# Never put an actual key in this example or version control.
NAVIGATOR_TOOLKIT_API_KEY=
NAVIGATOR_BASE_URL=https://api.ai.it.ufl.edu/v1
NAVIGATOR_MODEL=nemotron-3-nano-30b-a3b
COWINGMAN_TIMEOUT=15
COWINGMAN_CONTEXT_TTL=60

# Local NVIDIA archives created by scripts/prepare_speech_models.py.
# Set absolute paths on your Jetson. Adjacent integrity manifests are required.
COWINGMAN_ASR_MODEL_PATH=
# Optional input index from python3 -m cowingman --list-audio; blank = default.
COWINGMAN_AUDIO_DEVICE=

# Only used with --tts. ASR exits before these models load sequentially.
COWINGMAN_FASTPITCH_PATH=
COWINGMAN_HIFIGAN_PATH=
